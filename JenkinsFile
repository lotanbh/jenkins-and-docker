pipeline {
    agent any

    triggers {
        pollSCM('* * * * *') // Checks for Git changes every minute
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out code from GitHub repository automatically...'
                // פקודה חכמה הלוקחת את הגדרות הגיט וההרשאות ישירות מהגדרות ה-Job בג'נקינס
                checkout scm 
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies directly on Jenkins...'
                sh 'npm ci'
            }
        }

        stage('Test') {
            steps {
                echo 'Running application tests...'
                sh 'npm test'
            }
        }

        stage('Build image') {
            steps {
                echo "Building Docker image for build #${BUILD_NUMBER}..."
                sh 'docker build -t greets-app:${BUILD_NUMBER} -t greets-app:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application on port 8081 to avoid conflict with Jenkins...'
                sh 'docker rm -f greets-live || true' 
                sh 'docker run -d --name greets-live -p 8081:8080 greets-app:latest'
                echo 'Application is live and available at http://localhost:8081'
            }
        }
    }
    
    post {
        success {
            echo 'The Pipeline completed successfully!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}
