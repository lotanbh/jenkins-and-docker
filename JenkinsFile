pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'מושכים את הקוד מהמאגר'
                echo 'Checking out...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies directly on Jenkins...'
                sh 'npm ci'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing...'
                sh 'npm test'
            }
        }

        stage('Build image') {
            steps {
                echo 'Building...'
                echo 'בונים Docker Image עבור האפליקציה'
                sh 'docker build -t greets-app:${BUILD_NUMBER} -t greets-app:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying...'
                echo 'מריצים את האפליקציה על פורט 8080'
                sh 'docker rm -f greets-live || true'
                sh 'docker run -d --name greets-live -p 8080:8080 greets-app:latest'
            }
        }
    }
    
    post {
        success {
            echo 'The Pipeline succeeded!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}
