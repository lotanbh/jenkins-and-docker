pipeline {
    agent any

    triggers {
        pollSCM('* * * * *') // בודק שינויים בגיט בכל דקה
    }

    stages {
        // שלב Checkout יחיד ומאובטח המשתמש בטוקן שלך
        stage('Checkout Code') {
            steps {
                echo 'מושכים את הקוד מהמאגר בצורה מאובטחת...'
                checkout scmGit(
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/lotanbh/jenkins-and-docker.git', 
                        credentialsId: 'github-jen'
                    ]]
                )
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies directly on Jenkins...'
                sh 'npm ci'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing...'
                sh 'npm test'
            }
        }

        stage('Build image') {
            steps {
                echo "בונים Docker Image עבור האפליקציה (בילד #${BUILD_NUMBER})..."
                // שימוש במספר הבילד הדינמי כתגית
                sh 'docker build -t greets-app:${BUILD_NUMBER} -t greets-app:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'מריצים את האפליקציה על פורט 8081 (כדי לא להתנגש עם ג'נקינס)...'
                sh 'docker rm -f greets-live || true' // מונע קריסה אם הקונטיינר לא היה קיים
                
                // שינינו את הפורט החיצוני ל-8081. הוא יישאר קבוע ולא תצטרך לשנות אותו יותר לעולם!
                sh 'docker run -d --name greets-live -p 8081:8080 greets-app:latest'
                echo 'האפליקציה זמינה בכתובת: http://localhost:8081'
            }
        }
    }
    
    post {
        success {
            echo 'The Pipeline succeeded!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}
