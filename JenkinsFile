pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'מושכים את הקוד מהמאגר'
                echo 'Checking out...'
                checkout scm
            }
        }

        // שימוש בקונטיינר של Node.js רק עבור שלבי ההתקנה והטסטים
        stage('Build & Test NodeJS') {
            agent {
                docker { 
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            stages {
                stage('Install Dependencies') {
                    steps {
                        echo 'Installing dependencies inside Node container...'
                        sh 'npm ci'
                    }
                }

                stage('Test') {
                    steps {
                        echo 'Testing inside Node container...'
                        sh 'npm test'
                    }
                }
            }
        }

        // חזרה לסביבה הרגילה כדי לבנות ולהריץ את הדוקר הכללי של האפליקציה
        stage('Build image') {
            steps {
                echo 'Building...'
                echo 'בונים Docker Image'
                sh 'docker build -t jenkins:${BUILD_NUMBER} -t jenkins:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying...'
                echo 'מריצים את הגירסה החדשה על פורט 8001'
                sh 'docker rm -f greets-live || true'
                sh 'docker run -d --name greets-live -p 8001:8001 jenkins:latest'
            }
        }
    }
    
    post {
        success {
            echo 'The Pipeline succeeded!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}
