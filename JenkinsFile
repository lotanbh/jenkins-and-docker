pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'מושכים את הקוד מהמאגר'
                echo 'Checking out...'
                checkout scm
            }
        }

        stage('Build & Test NodeJS') {
            agent {
                docker { 
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            stages {
                stage('Install Dependencies') {
                    steps {
                        echo 'Installing dependencies inside Node container...'
                        sh 'npm ci'
                    }
                }

                stage('Test') {
                    steps {
                        echo 'Testing inside Node container...'
                        sh 'npm test'
                    }
                }
            }
        }

        stage('Build image') {
            steps {
                echo 'Building...'
                echo 'בונים Docker Image עבור האפליקציה'
                // שינינו את השם מ-jenkins ל-greets-app כדי למנוע בלבול
                sh 'docker build -t greets-app:${BUILD_NUMBER} -t greets-app:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying...'
                echo 'מריצים את האפליקציה על פורט 8080'
                sh 'docker rm -f greets-live || true'
                // האפליקציה מאזינה פנימית ל-8080 (לפי ה-Dockerfile שלה) וחשופה בפורט 8080 במחשב
                sh 'docker run -d --name greets-live -p 8080:8080 greets-app:latest'
            }
        }
    }
    
    post {
        success {
            echo 'The Pipeline succeeded!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}
