pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'מושכים את הקוד מהמאגר'
                echo 'Checking out...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh 'npm ci'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing...'
                echo 'מריצים את הבדיקות ואם יש שגיאות הבנייה תיכשל כאן'
                sh 'npm test'
            }
        }

        stage('Build image') {
            steps {
                echo 'Building...'
                echo 'בונים Docker Image'
                sh 'docker build -t jenkins:${BUILD_NUMBER} -t jenkins:latest .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying...'
                echo ' מריצים את הגירסה החדשה על פורט 8001'
                sh 'docker run -d --name greets-live -p 8001:8001 jenkins:latest'
            }
        }
    
    }
    post {
        success {
            echo 'The Pipeline succeeded!'
        }
        failure {
            echo 'The Pipeline failed!'
        }
    }
}